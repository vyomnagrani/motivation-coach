{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "foundryLocation": { "value": "${FOUNDRY_LOCATION=eastus}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "contentSourceUrl": { "value": "${CONTENT_SOURCE_URL=}" },
    "containerImage": { "value": "${MOTIVATION_COACH_IMAGE=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "agentVersion": { "value": "${FOUNDRY_VOICE_AGENT_VERSION=1}" },
    "publicOrigin": { "value": "${WEB_URL=}" }
  }
}
