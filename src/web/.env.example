# Replace this illustrative account with your own Foundry account.
FOUNDRY_PROJECT_ENDPOINT=https://motivation-coach.services.ai.azure.com/api/projects/motivation-coach-project
FOUNDRY_VOICE_AGENT_NAME=motivation-coach-agent
FOUNDRY_VOICE_AGENT_VERSION=1
# Exact external origin (no trailing slash); HTTPS required except localhost.
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
# Optional public text-only GitHub JSON; refreshed on page loads.
CONTENT_SOURCE_URL=
# Production: managed-identity. Local development only: azure-cli.
# For local development, explicitly set AZURE_AUTH_MODE=azure-cli after az login.
AZURE_AUTH_MODE=managed-identity
# Client ID of the user-assigned identity attached to the hosting resource.
AZURE_CLIENT_ID=
# Optional: CIDR allowlist of immediate ingress proxies; never trust all forwarded headers.
# TRUSTED_PROXY_CIDRS=10.0.0.0/24
